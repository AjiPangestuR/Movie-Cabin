# MOCAB - Supabase Environment Variables
# DILARANG memasukkan service_role key. Hanya URL dan anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# TMDB API (Server-Only, JANGAN gunakan prefix NEXT_PUBLIC_)
# Dapatkan API Read Access Token (v4 auth) dari https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=your-tmdb-read-access-token-here
